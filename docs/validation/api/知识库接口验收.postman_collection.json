{
  "info": {
    "name": "个人知识库接口验收",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json",
    "description": "可导入 Apifox/Postman。离线执行记录采用真实 FastAPI 路由与替身服务，不是这些客户端中的执行结果。LIVE-01 需要真实模型；响应依据需人工核对。"
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://127.0.0.1:8000",
      "type": "string"
    }
  ],
  "item": [
    {
      "name": "API-01 健康检查",
      "request": {
        "method": "GET",
        "header": [],
        "url": "{{baseUrl}}/health",
        "description": "返回索引状态"
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"HTTP 200\",()=>pm.response.to.have.status(200));",
              "pm.test(\"状态字段存在\",()=>pm.expect(pm.response.json()).to.have.property(\"index_ready\"));"
            ]
          }
        }
      ]
    },
    {
      "name": "API-02 正常检索",
      "request": {
        "method": "GET",
        "header": [],
        "url": "{{baseUrl}}/v1/search?q=RAG&top_k=3",
        "description": "返回结构化来源及原文链接"
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"HTTP 200\",()=>pm.response.to.have.status(200));",
              "pm.test(\"来源数组存在\",()=>pm.expect(pm.response.json().sources).to.be.an(\"array\"));",
              "const sources=pm.response.json().sources; if(sources.length) pm.collectionVariables.set(\"noteId\",sources[0].note_id);"
            ]
          }
        }
      ]
    },
    {
      "name": "API-03 top_k 下界",
      "request": {
        "method": "GET",
        "header": [],
        "url": "{{baseUrl}}/v1/search?q=RAG&top_k=0",
        "description": "拒绝小于 1 的 top_k"
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"HTTP 422\",()=>pm.response.to.have.status(422));"
            ]
          }
        }
      ]
    },
    {
      "name": "API-04 top_k 上界",
      "request": {
        "method": "GET",
        "header": [],
        "url": "{{baseUrl}}/v1/search?q=RAG&top_k=21",
        "description": "拒绝大于 20 的 top_k"
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"HTTP 422\",()=>pm.response.to.have.status(422));"
            ]
          }
        }
      ]
    },
    {
      "name": "API-05 缺少搜索词",
      "request": {
        "method": "GET",
        "header": [],
        "url": "{{baseUrl}}/v1/search",
        "description": "拒绝缺少 q 的请求"
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"HTTP 422\",()=>pm.response.to.have.status(422));"
            ]
          }
        }
      ]
    },
    {
      "name": "API-06 空问题",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": "{{baseUrl}}/v1/chat",
        "description": "拒绝空字符串问题",
        "body": {
          "mode": "raw",
          "raw": "{\"question\": \"\"}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"HTTP 422\",()=>pm.response.to.have.status(422));"
            ]
          }
        }
      ]
    },
    {
      "name": "API-07 缺少问题字段",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": "{{baseUrl}}/v1/chat",
        "description": "拒绝缺少 question 的请求",
        "body": {
          "mode": "raw",
          "raw": "{}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"HTTP 422\",()=>pm.response.to.have.status(422));"
            ]
          }
        }
      ]
    },
    {
      "name": "API-08 不存在的笔记",
      "request": {
        "method": "GET",
        "header": [],
        "url": "{{baseUrl}}/v1/notes/not-existing-demo-note",
        "description": "返回笔记不存在"
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"HTTP 404\",()=>pm.response.to.have.status(404));"
            ]
          }
        }
      ]
    },
    {
      "name": "API-10 接口文档",
      "request": {
        "method": "GET",
        "header": [],
        "url": "{{baseUrl}}/openapi.json",
        "description": "包含搜索与问答接口"
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"HTTP 200\",()=>pm.response.to.have.status(200));"
            ]
          }
        }
      ]
    },
    {
      "name": "LIVE-01 真实模型问答（需模型配置）",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": "{{baseUrl}}/v1/chat",
        "body": {
          "mode": "raw",
          "raw": "{\"question\":\"知识库如何约束模型幻觉？\"}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"HTTP 200\",()=>pm.response.to.have.status(200));",
              "pm.test(\"返回状态与来源\",()=>{const b=pm.response.json();pm.expect([\"answered\",\"no_evidence\"]).to.include(b.status);pm.expect(b.sources).to.be.an(\"array\");});"
            ]
          }
        }
      ]
    }
  ]
}